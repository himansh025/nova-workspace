# Dependencies
node_modules/
**/node_modules/

# Environment variable files (Keep secrets safe!)
.env
.env.*
.env*.local
*.env
**/.env
**/.env.*
**/.env*.local
!.env.example
!**/.env.example

# Certificates & Private Keys
*.pem
*.key
*.p8
*.pkcs12
*.pfx
*.crt
*.cert
id_rsa*
id_ed25519*
**/*.pem
**/*.key


# Next.js Build Outputs & Cache
.next/
**/.next/
out/
build/
dist/

# Local database & persistent data cache
.data/
**/.data/

# Isolated agent workspaces (Phase 5)
agent-run/
**/agent-run/

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

