# ==============================================================================
# NOVA WORKSPACE — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3007

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/nova-workspace

# Session & Authentication Secrets (Required)
SESSION_SECRET=your_minimum_32_character_session_secret_change_in_production
ARGON2_PEPPER=your_argon2_server_pepper_secret

# Dedicated Credential Encryption Key (AES-256-GCM for integrations)
# Should be a strong 32+ character random string distinct from SESSION_SECRET
CREDENTIAL_ENCRYPTION_KEY=your_credential_encryption_key_change_in_production

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3007

# ==============================================================================
# GITHUB APP INTEGRATION (RECOMMENDED ARCHITECTURE)
# ==============================================================================
# GitHub App ID (Numeric ID from GitHub App General Settings)
GITHUB_APP_ID=123456

# GitHub App Client ID & Secret (For OAuth flow if user identity requested)
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub App Private Key (PEM format, with escaped newlines \n or raw multi-line)
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# GitHub App Public URL (e.g. https://github.com/apps/your-nova-app)
GITHUB_APP_URL=https://github.com/apps/nova-workspace

# GitHub App Post-Installation Callback URL (configured in GitHub App settings)
GITHUB_CALLBACK_URL=http://localhost:3007/app/settings?tab=credentials

# GitHub Webhook HMAC Secret (Must match Webhook secret in GitHub App settings)
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# ==============================================================================
# EMAIL (SMTP) SERVICE (OPTIONAL)
# ==============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key
SMTP_FROM=noreply@nova.app
SMTP_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
